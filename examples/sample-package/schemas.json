{
  "contentTypes": {
    "api::website-page.website-page": {
      "uid": "api::website-page.website-page",
      "modelType": "contentType",
      "kind": "collectionType",
      "displayName": "Website Page",
      "options": { "draftAndPublish": true },
      "attributes": {
        "title": { "type": "string", "required": true },
        "slug": { "type": "uid", "targetField": "title" },
        "sections": {
          "type": "dynamiczone",
          "components": ["sections.hero", "sections.value-section"]
        },
        "relatedArticles": {
          "type": "relation",
          "relation": "manyToMany",
          "target": "api::article.article"
        }
      }
    }
  },
  "components": {
    "sections.hero": {
      "uid": "sections.hero",
      "modelType": "component",
      "attributes": {
        "title": { "type": "string" },
        "image": { "type": "media", "multiple": false }
      }
    },
    "sections.value-section": {
      "uid": "sections.value-section",
      "modelType": "component",
      "attributes": {
        "blocks": {
          "type": "dynamiczone",
          "components": ["sections.block-a", "sections.block-b"]
        }
      }
    }
  }
}
