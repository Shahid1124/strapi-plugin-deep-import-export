{
  "name": "strapi-plugin-deep-import-export",
  "version": "0.1.0",
  "description": "Schema-driven deep import and export for Strapi 5 content, components, dynamic zones, relations, and media.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "import",
    "export"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "admin",
    "server",
    "examples",
    "README.md",
    "strapi-server.js"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --require esbuild-register --test --test-reporter spec server/src/services/archive/archive.test.ts server/src/services/exporter/export.test.ts server/src/services/serializer/serialize.test.ts server/src/services/validation/import.test.ts"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "esbuild-register": "^3.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "strapi": {
    "kind": "plugin",
    "name": "deep-import-export",
    "displayName": "Deep Import / Export",
    "description": "Export and import nested Strapi 5 content without depending on database ids."
  }
}
